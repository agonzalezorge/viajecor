# El proyecto no tiene dependencias (ADR-003). Si aparece node_modules, es de
# alguna herramienta puntual y no va al repositorio.
node_modules/

# Datos personales: si alguna vez se deja un export en la carpeta, no se sube.
# Los gastos del usuario no van a un repositorio, ni siquiera a uno privado.
*.local.json
viajecor-*.json
viajecor-*.csv

# Ninguna planilla real entra al repositorio: los gastos del usuario son suyos.
*.xlsx
# Excepción: la planilla de ejemplo tiene montos inventados y la genera
# tools/generar-planilla-ejemplo.mjs. Sirve para construir y probar el importador.
!test/ejemplo/planilla-ejemplo.xlsx

.DS_Store
